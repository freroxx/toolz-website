{
  "functions": {
    "api/specs.ts": { "maxDuration": 25 },
    "api/spec.ts": { "maxDuration": 25 },
    "api/devicebot.ts": { "maxDuration": 25 },
    "api/sync-devices.ts": { "maxDuration": 25 },
    "api/reset.ts": { "maxDuration": 25 },
    "api/info.ts": { "maxDuration": 10 },
    "api/models.ts": { "maxDuration": 10 },
    "api/news.ts": { "maxDuration": 10 },
    "api/news-rss.ts": { "maxDuration": 10 },
    "api/news-admin.ts": { "maxDuration": 30 },
    "api/skins.ts": { "maxDuration": 15 }
  },
  "rewrites": [
    {
      "source": "/reset",
      "destination": "/api/reset"
    },
    {
      "source": "/api/news-version",
      "destination": "/api/news?action=version"
    },
    {
      "source": "/api/news-image",
      "destination": "/api/news-admin?action=image"
    },
    {
      "source": "/api/skins-admin",
      "destination": "/api/skins"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
